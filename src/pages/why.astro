---
import Layout from "../layouts/Layout.astro";

const title = "why bocc(dot)dev?";
const seoTitle = "why bocc(dot)dev?";
const seoDescription = "Why bocc(dot)dev?";
---

<Layout {title} {seoTitle} {seoDescription}>
	<main class="w-full p-8">
		<section
			class="space-y-8 sm:grid sm:grid-cols-3 border-b dark:border-grey-dark border-grey-mid pb-12"
		>
			<div class="sm:flex sm:flex-col sm:justify-between">
				<div>
					<a href={Astro.url.origin} class="font-mono text-sm"
						>bocc(dot)dev</a
					>
				</div>
				<div>
					<h1 class="font-medium text-xl pb-8">
						Why <span class="font-mono">bocc(dot)dev</span>
					</h1>
					<p>
						366 days ago I got married to my wife Phoebe and took
						her last name to continue the Bocchinelli family
						lineage (<a
							href="https://x.com/williamhibberd/status/1581174756736651268"
							target="_blank"
							rel="noopener">announcement</a
						>). On our honeymoon I toyed with the idea of changing
						my business name and purchased the domain <a
							href="https://bocc.dev">bocc.dev</a
						>. So what better way to celebrate 1 year of being Mr
						Bocchinelli than to launch bocc(dot)dev, my web design
						and development studio.
					</p>
				</div>
			</div>
		</section>
	</main>
</Layout>
